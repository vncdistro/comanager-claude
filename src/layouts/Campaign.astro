<!-- A/B test: stamp the ab-lp variant on analytics + fire signup_initiate -->
<script is:inline>
  (function () {
    var m = document.cookie.match(/(?:^|;\s*)ab-lp=([^;]+)/);
    var variant = m ? decodeURIComponent(m[1]) : null;
    if (variant) {
      // Rides along on every PostHog event from this browser.
      if (window.posthog) posthog.register({ ab_lp: variant });
      // Lets Clarity recordings/heatmaps be filtered by variant.
      if (window.clarity) window.clarity('set', 'ab_lp', variant);
    }
    // Conversion (start): any click through to the app counts as signup_initiate.
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest && e.target.closest('a[href*="app.comanager.com"]');
      if (a && window.posthog) {
        posthog.capture('signup_initiate', {
          ab_lp: variant || 'none',
          cta_href: a.getAttribute('href'),
          cta_text: (a.textContent || '').trim().slice(0, 60),
        });
      }
    }, true);
  })();
</script>
</body>
</html>
