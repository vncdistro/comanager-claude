<script is:inline>
  (function () {
    var m = document.cookie.match(/(?:^|;\s*)ab-lp=([^;]+)/);
    var variant = m ? decodeURIComponent(m[1]) : null;
    if (variant) {
      if (window.posthog) posthog.register({ ab_lp: variant });
      if (window.clarity) window.clarity('set', 'ab_lp', variant);
    }
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest && e.target.closest('a[href*="app.comanager.com"]');
      if (a && window.posthog) {
        posthog.capture('signup_initiate', {
          ab_lp: variant || 'none',
          cta_href: a.getAttribute('href'),
          cta_text: (a.textContent || '').trim().slice(0, 60),
        });
      }
    }, true);
  })();
</script>
</body>
</html>
