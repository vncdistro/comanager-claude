---
// /chat — AI launcher. UI reproduced EXACTLY from the supplied reference
// bundle ("Comanager Landing (standalone).html"): rendered markup + tokens
// are used verbatim (src/chatref/*), deliberately NOT the shared Campaign
// layout so no site CSS interferes. Fonts are the same families/weights as
// the bundle's, served from our self-hosted WOFF2.
// Kept (non-UI): canonical, PostHog + Clarity + ab-lp stamping, signup_initiate.
export const prerender = false;

import tokensCss from '../chatref/tokens.css?raw';
import baseCss from '../chatref/base.css?raw';
import markup from '../chatref/markup.html?raw';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const SIGNIN = 'https://app.comanager.com/sign-in';
const SIGNUP = 'https://app.comanager.com/sign-up';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>comanager — What's next for your music?</title>
<meta name="description" content="Your AI music manager. Ask what's next for your music — pitching, production, content, booking, release plans — and a full team of managers gets it done." />
<meta name="theme-color" content="#060605" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="canonical" href="https://comanager.com/" />
<style is:inline set:html={tokensCss}></style>
<style is:inline set:html={baseCss}></style>
</head>
<body>
<SiteNav
  links={[
    { label: 'How it works', href: '/#how' },
    { label: 'Pricing', href: '/#pricing' },
  ]}
  actions={[
    { label: 'Sign in', href: SIGNIN, kind: 'link', blank: true },
    { label: 'Sign up', href: SIGNUP, kind: 'pill', blank: true },
  ]}
/>
<Fragment set:html={markup} />
<SiteFooter
  links={[
    { label: 'Privacy', href: SIGNIN, blank: true },
    { label: 'Terms', href: SIGNIN, blank: true },
    { label: 'Contact', href: SIGNIN, blank: true },
  ]}
/>

<!-- Typewriter (the bundle animated this at runtime; frozen frame reset) -->
<script is:inline>
  (function () {
    var tw = document.querySelector('[data-tw]');
    var ta = document.querySelector('textarea.cm-input');
    if (!tw || !ta) return;
    var overlay = tw.parentElement;
    var phrases = [
      'Who should produce my next single?',
      'Write a pitch for my new single',
      'Plan a week of content in minutes',
      'Which playlists fit my sound?',
      'Map out my release timeline',
      'Book my first hometown show',
    ];
    var pi = 0, ci = 0, deleting = false;
    function tick() {
      if (ta.value || document.activeElement === ta) {
        overlay.style.opacity = '0';
        setTimeout(tick, 500);
        return;
      }
      overlay.style.opacity = '1';
      var full = phrases[pi];
      ci += deleting ? -1 : 1;
      tw.textContent = full.slice(0, ci);
      var delay = deleting ? 30 : 55;
      if (!deleting && ci === full.length) { deleting = true; delay = 1700; }
      else if (deleting && ci === 0) { deleting = false; pi = (pi + 1) % phrases.length; delay = 350; }
      setTimeout(tick, delay);
    }
    setTimeout(tick, 600);
    // Every interaction hands off to the app so the platform can continue it.
    var APP = 'https://app.comanager.com/sign-in';
    function go(promptText, source) {
      var url = promptText ? APP + '?prompt=' + encodeURIComponent(promptText) : APP;
      if (window.posthog) posthog.capture('signup_initiate', { ab_lp: (document.cookie.match(/ab-lp=([^;]+)/) || [])[1] || 'none', cta_href: source, cta_text: (promptText || '').slice(0, 120) });
      window.location.href = url;
    }
    // Send (submit) → carries the typed prompt
    var form = ta.closest('form');
    if (form) form.addEventListener('submit', function (e) {
      e.preventDefault();
      go(ta.value.trim(), 'chat-input');
    });
    // Attach (+) button → straight to sign-in (keeps any typed prompt along)
    var attach = document.querySelector('button[aria-label="Add attachment"]');
    if (attach) attach.addEventListener('click', function () {
      go(ta.value.trim(), 'chat-attach');
    });
    // Enter (without Shift) in the textarea also sends
    ta.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); go(ta.value.trim(), 'chat-input'); }
    });
  })();
</script>

