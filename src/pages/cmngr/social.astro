---
// Campaign landing page → served at /cmngr/social
// SSR so the Worker answers the bare path directly (Webflow Cloud strips
// trailing slashes). Built entirely from the Comanager design system.
export const prerender = false;
import Campaign from '../../layouts/Campaign.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const SIGNIN = 'https://app.comanager.com/sign-in';

const stats = [
  { fig: '2.9B', label: 'Monthly active users on Facebook, still the largest social platform on earth.' },
  { fig: '2.5B', label: 'Monthly users on YouTube, second only to Facebook in reach.' },
  { fig: '170M', label: 'Instagram users in the US as of 2025, plus over 2 billion globally.' },
  { fig: '135M', label: 'US users on TikTok, the fastest growing platform and still climbing.' },
];

const platforms = [
  { num: '01', name: 'Instagram', tag: 'Visual identity and community', body: `Reels reach new audiences who do not follow you yet. Stories build daily connection with the fan base you already have. Both matter, and music discovery and community happen side by side.` },
  { num: '02', name: 'TikTok', tag: 'Where music breaks', body: `Songs go viral here before they chart anywhere else. TikTok rewards consistency and creativity over follower count, which makes it the place new artists break in. Short, raw video built around your sound is the move.` },
  { num: '03', name: 'YouTube', tag: 'Long-term careers', body: `Music videos still matter. So do live streams, studio sessions, and vlogs. Shorts gives you a second algorithm to play with, and the platform is where artists build a catalog that pays off for years.` },
  { num: '04', name: 'Facebook', tag: 'Undervalued right now', body: `Fewer artists post here, so there is less competition for attention. Video and photo carousels outperform plain text, older fans still live here, and live streams perform well. Four to seven posts a week is effective.` },
  { num: '05', name: 'Apple Music & Spotify', tag: 'Where your music lives', body: `Not social platforms in the traditional sense, but both have features artists overlook. Apple Music profiles, Spotify Canvas videos, and playlist placements all shape how new fans discover you.` },
];

const pillars = [
  { num: '01', title: 'Know your audience', body: `Not "music fans." Which cities, which other musicians they follow, which platforms they live on, which moments in your journey resonate. The more specific your understanding, the easier every other decision becomes.` },
  { num: '02', title: 'Pick the right platforms', body: `You do not need to be everywhere. A producer might thrive on TikTok and YouTube. A folk artist on Instagram and Substack. A rapper on Twitter and TikTok. The two you commit to will outperform six you barely touch.` },
  { num: '03', title: 'Plan your content', body: `A content plan turns social from a daily anxiety into a system. Pick your pillars. Plan around releases, tour promo, and the moments in your process worth sharing. Mix promotion with engagement and behind-the-scenes.` },
  { num: '04', title: 'Track what works', body: `Every platform gives you the data. Most artists never look. Watch engagement rates, follower growth, post reach, saves, and shares. The ones who read the numbers learn faster than the ones who do not.` },
];

const content = [
  { mgr: 'creative', kicker: 'Music & performance', title: 'Music videos and clips', body: `Your music is the product. Vertical clips work best for Reels, TikTok, and Shorts. Horizontal versions still belong on YouTube as full music videos.` },
  { mgr: 'social', kicker: 'Behind the scenes', title: 'Your creative process', body: `Studio sessions, songwriting moments, gear, rehearsals. Fans want to feel close to the music. This tends to outperform polished promo because it feels real.` },
  { mgr: 'fan', kicker: 'Community', title: 'Engagement posts', body: `Questions, polls, live streams, giveaways, replies to comments. Every story reply and every Live is a chance to turn a casual listener into a real fan.` },
  { mgr: 'marketing', kicker: 'Fans do the work', title: 'User generated content', body: `When fans post your music in their own videos, that is the highest-converting promotion you can get. Encourage it, repost it, and build trends others can join.` },
  { mgr: 'opportunities', kicker: 'Reach new fans', title: 'Collaborations', body: `A duet on TikTok puts your music in front of another artist's entire fan base. A YouTube collab borrows the trust of the creator hosting you. One of the fastest ways to reach new audiences without ads.` },
];

const cadence = [
  { name: 'Instagram', cad: `3 to 5 Reels per week, plus daily Stories. Reels drive discovery, Stories build retention.` },
  { name: 'TikTok', cad: `5 to 7 posts per week. The algorithm rewards consistency, and new artists need volume to find their audience.` },
  { name: 'YouTube', cad: `1 to 2 long-form videos per month, plus 3 to 5 Shorts per week.` },
  { name: 'Facebook', cad: `4 to 7 posts per week, with at least one live stream a month.` },
];

const mistakes = [
  { num: '01', title: 'Posting only to sell', body: `Your audience will not keep showing up for ads. Mix promotional content with everything else.` },
  { num: '02', title: 'Treating every platform the same', body: `What works on TikTok does not always work on Instagram or YouTube. Adapt the content to the platform.` },
  { num: '03', title: 'Ignoring engagement', body: `Replying to comments and DMs is part of the job. Skip it and you build follower counts without a community.` },
  { num: '04', title: 'Chasing off-brand trends', body: `Sometimes a trend fits. Sometimes it does not. Forcing yourself into trends that clash with your music dilutes your brand.` },
  { num: '05', title: 'Watching the wrong metrics', body: `Follower growth is a vanity number. Engagement rates, saves, shares, and DMs tell you whether you are building a fan base.` },
];

const timeline = [
  { when: 'Two to three weeks out', title: 'Tease the new music', body: `Build curiosity. Drop short clips. Let your audience hear pieces before the full release lands.` },
  { when: 'Release week', title: 'Go heavy', body: `Post the music video. Drop behind-the-scenes from the recording. Go live. Ask fans to share. Push for playlist placements alongside the social push.` },
  { when: 'The month after', title: 'Keep it alive', body: `New angles. Different clips. Acoustic versions. Fan-submitted content. Most artists post once and disappear, which is why their releases die fast.` },
];

const emailBits = [
  `Your latest news, in your own voice.`,
  `One exclusive demo or photo fans cannot get anywhere else.`,
  `A single personal note from you.`,
];

const inside = [
  { title: 'A custom platform plan', body: `Based on your music and your audience. Not every artist belongs on every platform. comanager picks the right ones for you.` },
  { title: 'A content calendar', body: `Reels, TikTok ideas, Shorts concepts, long-form suggestions, and Stories prompts that fit your genre.` },
  { title: 'A cadence you can keep', body: `Realistic for your stage of career, not built for a major-label budget.` },
  { title: 'Engagement strategies', body: `Live streams, giveaways, community prompts, and ways to encourage user generated content.` },
  { title: 'Release campaigns', body: `Built around your actual release calendar and tour promo, not a generic template.` },
  { title: 'Collaboration suggestions', body: `Other musicians and creators in your space who can put your music in front of new audiences.` },
];

const faqs = [
  { q: 'What is the best platform for musicians?', a: `Most independent artists should focus on TikTok and Instagram first. TikTok drives discovery as the fastest growing platform. Instagram builds community with its 170 million US users and global reach. YouTube becomes essential as you release music videos and longer content. Apple Music and Spotify are where your music ultimately lives, so they tie into the strategy.` },
  { q: 'How often should musicians post?', a: `Often enough to stay in your audience's feed without burning out. 3 to 5 Instagram Reels a week, daily Stories, 5 to 7 TikToks, 4 to 7 Facebook posts, and 1 to 2 YouTube videos a month is a realistic starting point.` },
  { q: 'How can artists grow without a budget?', a: `Consistency, the right content for each platform, and real engagement with your fans. You do not need ads to grow. You need a strategy. The artists growing fastest right now figured out how to use social before they had any money to spend.` },
  { q: 'Should I be on every platform?', a: `No. Pick the platforms that fit your sound and your audience. Two platforms you commit to will outperform six you barely touch. comanager helps you identify the right ones based on your music.` },
  { q: 'Why do musicians need email newsletters?', a: `Email is a reliable channel that social platforms cannot replicate. Your list is the one audience you own, untouched by algorithm changes. Social finds new fans. Email keeps them. Together they build careers that last.` },
  { q: 'How does comanager build my strategy?', a: `You answer questions about your sound, your goals, and your current audience. comanager builds a custom plan tailored to you. Platform picks, content ideas, posting cadence, and engagement plans. Free to start.` },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Campaign
  title="Social media for musicians — Comanager"
  description="Social media is where your music lives now. How independent artists actually grow, platform by platform — and how comanager builds your custom social strategy in minutes."
  heroImg="/assets/img/hero-social.webp"
>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>

<div class="social">

<!-- NAV (chat-style, componentized) -->
<SiteNav
  overlay={true}
  links={[
    { label: 'Platforms', href: '#platforms' },
    { label: 'Content', href: '#content' },
    { label: 'FAQ', href: '#faq' },
  ]}
  actions={[{ label: 'Create my strategy', href: SIGNIN, kind: 'pill' }]}
/>

<!-- HERO -->
<header class="hero section" data-side="right" id="top" style="--hero-img:url('/assets/img/hero-social.webp')">
  <div class="hero-photo"></div>
  <div class="hero-veil"></div>
  <div class="hero-veil-v"></div>
  <div class="hero-inner wrap">
    <div class="hero-copy">
      <span class="eyebrow eyebrow-pill">The strategy guide for independent artists</span>
      <h1>Social media is where your music <span class="serif">lives now.</span></h1>
      <p class="hero-sub">Every release, every show, every fan relationship runs through social before it touches anything else. Here is how independent artists actually grow, platform by platform.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={SIGNIN}>Create my social strategy <span class="arrow"></span></a>
      </div>
    </div>
  </div>
</header>

<!-- STATS -->
<section class="section wrap" id="audience">
  <span class="eyebrow reveal" style="display:inline-flex;margin-bottom:22px"><span class="dot"></span>Where the audience actually is</span>
  <div class="stat-row reveal">
    {stats.map((s) => (
      <div>
        <div class="stat-fig">{s.fig}</div>
        <p class="stat-label">{s.label}</p>
      </div>
    ))}
  </div>
</section>

<!-- THE SHIFT -->
<section class="section wrap" id="shift">
  <div class="editorial reveal">
    <div>
      <span class="eyebrow"><span class="dot"></span>The shift</span>
      <h2 class="sec-title" style="margin-top:16px">The gatekeepers <span class="serif">lost the keys.</span></h2>
    </div>
    <div class="editorial-body">
      <p>For most of music history, labels, radio, and booking agents decided who got heard. If you were not on their list, you were not getting through. Social media broke that system.</p>
      <p>Today independent artists connect directly with new fans, build global reach, and skip the gatekeepers. The same tools major labels use to promote their roster are free and available to every artist with a phone. The opportunity is real. The problem is that most artists still treat social like a billboard instead of a conversation.</p>
    </div>
  </div>
</section>

<!-- PLATFORMS -->
<section class="section wrap" id="platforms">
  <div class="sec-head reveal">
    <span class="eyebrow"><span class="dot"></span>The platforms that matter now</span>
    <h2 class="sec-title">Two platforms you commit to beat <span class="serif">six you barely touch.</span></h2>
  </div>
  <div class="platform-list reveal">
    {platforms.map((p) => (
      <div class="platform-row">
        <span class="pnum">{p.num}</span>
        <div><h3>{p.name}</h3><span class="ptag">{p.tag}</span></div>
        <p>{p.body}</p>
      </div>
    ))}
  </div>
  <p class="aura-note reveal" style="margin-top:30px">Not sure which platforms fit your sound?&nbsp; <a href={SIGNIN}>Find your platforms</a></p>
</section>

<!-- STRATEGY / FOUR QUESTIONS -->
<section class="section wrap" id="strategy">
  <div class="sec-head reveal">
    <span class="eyebrow"><span class="dot"></span>What a real strategy answers</span>
    <h2 class="sec-title">Four questions.<br /><span class="serif">Most artists answer none.</span></h2>
  </div>
  <div class="numgrid two reveal">
    {pillars.map((p) => (
      <div class="numcard">
        <div class="nnum">{p.num}</div>
        <h3>{p.title}</h3>
        <p>{p.body}</p>
      </div>
    ))}
  </div>
</section>

<!-- CONTENT TYPES (manager-color cards) -->
<section class="section wrap" id="content">
  <div class="sec-head reveal">
    <span class="eyebrow"><span class="dot"></span>The content that works</span>
    <h2 class="sec-title">Five kinds of post. <span class="serif">Each does a different job.</span></h2>
  </div>
  <div class="mgr-card-grid reveal">
    {content.map((c) => (
      <article class="mgr-card" data-mgr={c.mgr}>
        <span class="eyebrow"><span class="dot"></span>{c.kicker}</span>
        <h3>{c.title}</h3>
        <p>{c.body}</p>
      </article>
    ))}
  </div>
</section>

<!-- BENCHMARKS -->
<section class="section wrap" id="cadence">
  <div class="sec-head reveal">
    <span class="eyebrow"><span class="dot"></span>How often to post</span>
    <h2 class="sec-title">Honest benchmarks <span class="serif">for emerging artists.</span></h2>
    <p class="hero-sub" style="margin-top:18px;max-width:60ch">Skipping weeks resets your reach. The goal is to post often enough that the algorithm trusts you and your audience expects to hear from you.</p>
  </div>
  <div class="bench reveal">
    {cadence.map((c) => (
      <div class="bench-row">
        <h3>{c.name}</h3>
        <p>{c.cad}</p>
      </div>
    ))}
  </div>
  <div class="statement-card reveal">
    <p>comanager builds a posting cadence you can actually keep, realistic for your stage of career.</p>
    <a class="btn btn-primary" href={SIGNIN}>Build my calendar <span class="arrow"></span></a>
  </div>
</section>

<!-- CASE STUDY -->
<section class="section wrap" id="case">
  <div class="casestudy reveal">
    <div>
      <span class="eyebrow"><span class="dot"></span>Authenticity wins</span>
      <h2 class="sec-title" style="margin-top:16px">A strategy that <span class="serif">actually works.</span></h2>
      <p class="hero-sub" style="margin-top:18px;max-width:48ch">Fans can spot a corporate post from across the feed. Your voice, your humor, your point of view. Exclusive content on the platforms where your fans already live is how you access a fan base.</p>
    </div>
    <div class="casestat">
      <div class="big">7M</div>
      <p>Followers Billie Eilish gained through exclusive content on Instagram. By giving fans something they could only get from her.</p>
    </div>
  </div>
  <a class="case-frame reveal" href="https://www.venicemusic.co/strategy/billie-eilish" style="background-image:url('/assets/img/case-billie.webp');background-position:center 30%" aria-label="Read the breakdown: Billie Eilish's Hit Me Hard and Soft">
    <span class="case-badge">Read the breakdown <span class="arrow"></span></span>
  </a>
</section>

<!-- MISTAKES -->
<section class="section wrap" id="mistakes">
  <div class="sec-head reveal">
    <span class="eyebrow"><span class="dot"></span>Common mistakes</span>
    <h2 class="sec-title">What holds back <span class="serif">even talented artists.</span></h2>
  </div>
  <div class="pitfalls reveal">
    {mistakes.map((m) => (
      <div class="pitfall">
        <span class="pnum">{m.num}</span>
        <h3>{m.title}</h3>
        <p>{m.body}</p>
      </div>
    ))}
  </div>
</section>

<!-- RELEASE TIMELINE -->
<section class="steps section" id="release">
  <div class="steps-glow"></div>
  <div class="steps-glow b"></div>
  <div class="steps-glow c"></div>
  <div class="inner wrap">
    <div class="sec-head center reveal">
      <span class="eyebrow" style="justify-content:center"><span class="dot"></span>Promoting a release</span>
      <h2 class="sec-title">Start before the song is <span class="serif">even live.</span></h2>
    </div>
    <div class="steps-grid">
      {timeline.map((t, i) => (
        <div class="step reveal" data-d={(i + 1).toString()}>
          <span class="label" style="display:block;margin:0 0 6px">{t.when}</span>
          <h3>{t.title}</h3><div class="rule"></div>
          <p>{t.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- EMAIL -->
<section class="section wrap" id="email">
  <div class="split reveal">
    <div class="split-body">
      <span class="eyebrow"><span class="dot"></span>Own your audience</span>
      <h2 class="sec-title" style="margin:16px 0 18px">Why email belongs in <span class="serif">your strategy.</span></h2>
      <p>Platforms can change their algorithms overnight. Followers you spent years building can stop seeing your posts in a week. Your email list is the one audience you actually own.</p>
      <p>Treat social as the top of the funnel and email as the bottom. Instagram and TikTok find new fans. Email turns those fans into a long-term audience that shows up for every release.</p>
    </div>
    <div class="bullet-card">
      <p class="bc-head">A working monthly email</p>
      <ul>
        {emailBits.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </div>
</section>

<!-- PRODUCT -->
<section class="section wrap" id="product">
  <div class="product-panel reveal">
    <div class="product-top">
      <div>
        <span class="eyebrow"><span class="dot"></span>Your social manager</span>
        <h2 class="sec-title" style="margin:16px 0 16px">comanager builds your strategy in <span class="serif">minutes.</span></h2>
        <p class="hero-sub" style="max-width:46ch;margin-bottom:26px">Answer a few questions about your music and your career stage. comanager builds the plan. Platform picks, content pillars, posting cadence, and the analytics to track once you start.</p>
        <a class="btn btn-primary" href={SIGNIN}>Create my social strategy <span class="arrow"></span></a>
      </div>
      <div class="pimg" style="background-image:url('/assets/img/product-social.webp');background-position:center 28%"></div>
    </div>
    <div class="product-divider"></div>
    <span class="label">What is inside your strategy</span>
    <div class="check-grid" style="margin-top:24px">
      {inside.map((it) => (
        <div class="check">
          <svg class="ck" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <div><b>{it.title}</b><span>{it.body}</span></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section wrap" id="faq">
  <div class="sec-head center reveal">
    <span class="eyebrow" style="justify-content:center"><span class="dot"></span>Frequently asked</span>
    <h2 class="sec-title">Social media for musicians, <span class="serif">answered.</span></h2>
  </div>
  <div class="faq reveal">
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<!-- FINAL CTA -->
<section class="cta-sec section" id="cta">
  <div class="cta-card" style="--cta-img:url('/assets/img/cta-aura.webp')">
    <div class="photo"></div>
    <div class="veil"></div>
    <div class="inner reveal">
      <span class="eyebrow" style="justify-content:center"><span class="dot"></span>Free to start</span>
      <h2>Stop guessing.<span class="tell">Start growing.</span></h2>
      <p class="hero-sub" style="max-width:48ch;margin:18px auto 0">Let comanager build your custom social media strategy and the content plan that fits your music. Made for independent artists. Designed to grow with you.</p>
      <div class="cta"><a class="btn btn-primary" href={SIGNIN}>Create my social strategy <span class="arrow"></span></a></div>
    </div>
  </div>
</section>

<!-- FOOTER (chat-style, componentized) -->
<SiteFooter text="Built for independent artists. Powered by comanager." />

</div>

</Campaign>
