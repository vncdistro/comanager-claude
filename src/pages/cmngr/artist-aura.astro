---
// Campaign landing page → served at /cmngr/artist-aura
// SSR (prerender=false) so the Worker answers the bare path directly; Webflow
// Cloud strips trailing slashes, so a prerendered index would 307-redirect.
//
// To add another campaign: copy this file to src/pages/<slug>.astro (it goes
// live at /cmngr/<slug>), swap the copy/sections, and set heroImg to that
// page's hero so it gets preloaded. The <head>, modal and JS come from the
// shared Campaign layout automatically.
export const prerender = false;
import Campaign from '../../layouts/Campaign.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<Campaign
  title="Comanager — Let us make your artist brand book"
  description="Your free Artist Aura gives you a complete visual identity, personalized to your music."
  heroImg="/assets/img/hero-aura.webp"
>

<!-- NAV (chat-style, componentized) -->
<SiteNav
  overlay={true}
  links={[
    { label: 'Aura', href: '#aura' },
    { label: 'How it works', href: '#how' },
    { label: 'Artists', href: '#quotes' },
    { label: 'Pricing', href: 'http://comanager.com/#pricing' },
  ]}
  actions={[{ label: 'Meet Your Managers', href: 'https://app.comanager.com/sign-in', kind: 'pill' }]}
/>

<!-- HERO (split) -->
<header class="hero section" data-side="right" id="top" style="--hero-img:url('/assets/img/hero-aura.webp')">
  <div class="hero-photo"></div>
  <div class="hero-veil"></div>
  <div class="hero-veil-v"></div>
  <div class="hero-inner wrap">
    <div class="hero-copy">
      <span class="eyebrow"><span class="dot"></span>Free · 5 minutes · comanager</span>
      <h1>Let us make your<br />artist <span class="serif">brand book.</span></h1>
      <p class="hero-sub">Your free Artist Aura gives you a complete visual identity, personalized to your music.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="https://app.comanager.com/sign-in">Get Your Artist Aura <span class="arrow"></span></a>
      </div>
    </div>
  </div>
</header>

<!-- AURA -->
<section class="aura section wrap" id="aura">
  <h2 class="serif-lead reveal">What the branding labels charge thousands for — free in 5 minutes.</h2>
  <span class="label reveal">What's in your Aura</span>
  <div class="aura-grid">
    <div class="aura-item reveal" data-d="1">New Artist Bio</div>
    <div class="aura-item reveal" data-d="2">Your Core Themes</div>
    <div class="aura-item reveal" data-d="1">Visual World</div>
    <div class="aura-item reveal" data-d="2">Tone of Voice</div>
    <div class="aura-item reveal" data-d="1">Fan Archetypes</div>
    <div class="aura-item reveal" data-d="2">What to Improve</div>
    <div class="aura-item reveal" data-d="1">What Makes You Unique</div>
    <div class="aura-item reveal" data-d="2">Your Biggest Opportunity</div>
  </div>
  <p class="aura-note reveal">See example — Maria Carmen's Artist Aura&nbsp; <a href="https://comanager.com/comanager-example">Click here</a></p>
  <div class="reveal">
    <a class="btn btn-primary" href="https://app.comanager.com/sign-in">See Your Artist Aura <span class="arrow"></span></a>
  </div>
</section>

<!-- STEPS -->
<section class="steps section" id="how">
  <div class="steps-glow"></div>
  <div class="steps-glow b"></div>
  <div class="steps-glow c"></div>
  <div class="inner wrap">
    <h2 class="serif-lead reveal">Built in 3 steps.</h2>
    <div class="steps-grid">
      <div class="step reveal" data-d="1">
        <div class="num">01</div><h3>Your Identity</h3><div class="rule"></div>
        <p>The bio, the brand, the voice. All the things you've struggled to put into words.</p>
      </div>
      <div class="step reveal" data-d="2">
        <div class="num">02</div><h3>Your Fans</h3><div class="rule"></div>
        <p>Your fan archetypes, mapped. We name them, find them, and give you the playbook to grow.</p>
      </div>
      <div class="step reveal" data-d="3">
        <div class="num">03</div><h3>Your Roadmap</h3><div class="rule"></div>
        <p>What's working. Where the gaps are. Where to focus next.</p>
      </div>
    </div>
    <p class="steps-statement reveal">The Aura tells you what to do, comanager is the team that does it with you.</p>
    <div class="cta reveal">
      <a class="btn btn-primary" href="https://app.comanager.com/sign-in">Meet comanager <span class="arrow"></span></a>
    </div>
  </div>
</section>

<!-- QUOTES (carousel) -->
<section class="quotes section wrap" id="quotes">
  <h2 class="serif-lead reveal">Artists are impressed by Aura.</h2>
  <div class="q-stage" data-carousel data-interval="4800">
    <article class="q-card"><span class="mark">&ldquo;</span><blockquote>The Aura book gave me a really clear picture of where I'm at as an artist right now.</blockquote><cite>— Yuneer Gainz</cite></article>
    <article class="q-card"><span class="mark">&ldquo;</span><blockquote>comanager helped me map out my entire release plan through 2027. I'm rolling out 20 songs as four EPs, and the Aura analysis is what made that strategy feel actually doable instead of overwhelming.</blockquote><cite>— Mariah Meshae</cite></article>
    <article class="q-card"><span class="mark">&ldquo;</span><blockquote>The Aura layout broke down my workflow and my brand in a way nothing else had. In the 30 days since I leaned into comanager, my Instagram profile views went from around 5,000 to 21,700. That's a 4x lift I can't ignore.</blockquote><cite>— Dylan Bernard</cite></article>
    <article class="q-card"><span class="mark">&ldquo;</span><blockquote>The brand perception analysis in Aura gave me a real look at how my brand actually reads from the outside. It's the kind of perspective I'd usually only get from a manager.</blockquote><cite>— Mari Poydras</cite></article>
    <article class="q-card"><span class="mark">&ldquo;</span><blockquote>The Aura feature was really cool. Some of the insights felt genuinely interesting and useful, and the direction it pointed me in landed.</blockquote><cite>— Agat Schwarz</cite></article>
  </div>
  <div class="q-dots" data-dots>
    <span class="q-dot" data-on="1"></span>
    <span class="q-dot" data-on="0"></span>
    <span class="q-dot" data-on="0"></span>
    <span class="q-dot" data-on="0"></span>
    <span class="q-dot" data-on="0"></span>
  </div>
</section>

<!-- CTA (banner) -->
<section class="cta-sec section" id="story">
  <div class="cta-card" style="--cta-img:url('/assets/img/cta-aura.webp')">
    <div class="photo"></div>
    <div class="veil"></div>
    <div class="inner reveal">
      <h2>Your music has a story.<span class="tell">Let's tell it right.</span></h2>
      <div class="cta"><a class="btn btn-primary" href="https://app.comanager.com/sign-in">Join the Waitlist <span class="arrow"></span></a></div>
    </div>
  </div>
</section>

<!-- FOOTER (chat-style, componentized) -->
<SiteFooter text="A music manager for independent artists — pitches, strategy and content, so you can focus on the music." />

</Campaign>
