---
// Home page → served at / (comanager.com)
// Built entirely from the Comanager design system.
export const prerender = false;
import Campaign from '../layouts/Campaign.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const SIGNIN = 'https://app.comanager.com/sign-in';

const steps = [
  { t: 'comanager gets to know you', b: 'In a couple of minutes, comanager reads your whole career.' },
  { t: 'Get your Weekly Moves.', b: 'Come back to real work comanager already did for you.' },
  { t: 'Just say go.', b: 'Approve it, and comanager takes it from there.' },
];

const auraBits = [
  'Your artist bio, written for you.',
  'Core themes: what makes you, you.',
  'Your look and visual style.',
  'Your voice, and how you talk to fans.',
  'Who your fans actually are.',
  'Your influences, and how they show up.',
  "What's already working, and where you can grow.",
  'Your #1 opportunity and the first fix to make.',
];

const weekly = [
  'Three moves a week, already done for you — not a to-do list.',
  "It knows where you're at with your career and releases.",
  "We get things moving while you're offline.",
];

const pitching = [
  'Real matches curated for your sound and genre.',
  'We write the pitch for you.',
  'You approve it, we send it on your behalf.',
  'Works for playlists, booking venues, and reaching producers.',
];

const socialBits = [
  "A social strategy for whether you're releasing, off cycle, or on tour.",
  "Post ideas you'll actually want to share.",
  'Captions that sound like you.',
  'Scheduled for you, so you never have to think about it.',
];

const quotes = [
  "It's actually SO good… it's already helping me sort out so many of my thoughts and questions with my music.",
  "It's already helping me get more clarity on what I need to do next as an independent artist.",
  'comanager showed me things to build on… comanager is a game changer for real.',
];

const freePlan = [
  'Build your full Artist Aura',
  'See your first week of Weekly Moves',
  'Try pitching to real playlists and venues',
  'Ask comanager anything',
];

const proPlan = [
  'Fresh Weekly Moves every week, done and waiting for you',
  'Unlimited pitching to playlists, venues, and collaborators — sent for you',
  'Your entire social handled: strategy, posts, captions, and scheduling',
  'comanager on call whenever you need it',
  "Everything built around your Artist Aura, so it's always you",
];

const faqs = [
  { q: 'Do I need a label or manager already?', a: 'No. comanager is built for artists doing it themselves.' },
  { q: 'What do I need to start?', a: 'Just a couple of minutes. comanager builds your Aura and takes it from there.' },
  { q: 'How does the pitching work?', a: 'comanager finds the right playlists, venues, and producers for you, writes the pitch, and sends it once you approve.' },
  { q: 'Is it free to start?', a: 'Yes. Build your Aura and run your first moves free, no card.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Campaign
  title="Comanager — Your music career, managed."
  description="Your comanager learns your career, tells you what to do next, and does the work for you. Built by people who've managed artists, for the ones doing it themselves."
  heroImg="/assets/img/hero-aura.webp"
  canonical="https://comanager.com/"
>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>

<div class="home">

<!-- NAV (chat-style, componentized) -->
<SiteNav
  overlay={true}
  links={[
    { label: 'How it works', href: '#how' },
    { label: 'Aura', href: '#aura' },
    { label: 'Pricing', href: '#pricing' },
    { label: 'FAQ', href: '#faq' },
  ]}
  actions={[{ label: 'Start free', href: SIGNIN, kind: 'pill' }]}
/>

<!-- HERO -->
<header class="hero section" data-side="right" id="top" style="--hero-img:url('/assets/img/hero-aura.webp')">
  <div class="hero-photo"></div>
  <div class="hero-veil"></div>
  <div class="hero-veil-v"></div>
  <div class="hero-inner wrap">
    <div class="hero-copy">
      <span class="eyebrow"><span class="dot"></span>Every artist deserves a manager</span>
      <h1>Your music career, <span class="serif">managed.</span></h1>
      <p class="hero-sub">Your comanager learns your career, tells you what to do next, and does the work for you. Built by people who've managed artists — for the ones doing it themselves.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={SIGNIN}>Start free <span class="arrow"></span></a>
      </div>
    </div>
  </div>
</header>

<!-- HOW IT WORKS -->
<section class="steps section" id="how">
  <div class="steps-glow"></div>
  <div class="steps-glow b"></div>
  <div class="steps-glow c"></div>
  <div class="inner wrap">
    <div class="sec-head center reveal">
      <span class="eyebrow" style="justify-content:center"><span class="dot"></span>How it works</span>
      <h2 class="sec-title">A manager used to take a lucky break. <span class="serif">Now it takes two minutes.</span></h2>
    </div>
    <div class="steps-grid">
      {steps.map((s, i) => (
        <div class="step reveal" data-d={(i + 1).toString()}>
          <div class="num">{(i + 1).toString().padStart(2, '0')}</div>
          <h3>{s.t}</h3><div class="rule"></div>
          <p>{s.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- AURA -->
<section class="section wrap" id="aura">
  <div class="sec-head reveal">
    <span class="eyebrow"><span class="dot"></span>Artist Aura</span>
    <h2 class="sec-title">Aura knows <span class="serif">your career.</span></h2>
    <p class="hero-sub" style="margin-top:18px;max-width:62ch">The second you start, comanager builds your Aura — a full picture of you as an artist. It's the starting point for everything else. Here's what you get.</p>
  </div>
  <div class="check-grid reveal">
    {auraBits.map((b) => (
      <div class="check">
        <svg class="ck" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        <div><b>{b}</b></div>
      </div>
    ))}
  </div>
</section>

<!-- WEEKLY MOVES -->
<section class="section wrap" id="weekly">
  <div class="split reveal">
    <div class="split-body">
      <span class="eyebrow"><span class="dot"></span>Weekly Moves</span>
      <h2 class="sec-title" style="margin:16px 0 18px">Here's what I got done for you <span class="serif">this week.</span></h2>
      <p>Three things done for you every week — before you even ask.</p>
    </div>
    <div class="bullet-card">
      <p class="bc-head">Done for you</p>
      <ul>{weekly.map((b) => <li>{b}</li>)}</ul>
    </div>
  </div>
</section>

<!-- PITCHING -->
<section class="section wrap" id="pitching">
  <div class="split reveal">
    <div class="split-body">
      <span class="eyebrow"><span class="dot"></span>Pitching</span>
      <h2 class="sec-title" style="margin:16px 0 18px">We find the right people, write the pitch, <span class="serif">and send it for you.</span></h2>
      <p>comanager finds your matches, writes the pitch, and sends it the second you approve.</p>
    </div>
    <div class="bullet-card">
      <p class="bc-head">How it works</p>
      <ul>{pitching.map((b) => <li>{b}</li>)}</ul>
    </div>
  </div>
</section>

<!-- SOCIAL -->
<section class="section wrap" id="social">
  <div class="split reveal">
    <div class="split-body">
      <span class="eyebrow"><span class="dot"></span>Social</span>
      <h2 class="sec-title" style="margin:16px 0 18px">Turn your camera roll into <span class="serif">a social strategy.</span></h2>
      <p>comanager builds a social strategy around your release, writes the posts, and schedules them out for you.</p>
    </div>
    <div class="bullet-card">
      <p class="bc-head">What you get</p>
      <ul>{socialBits.map((b) => <li>{b}</li>)}</ul>
    </div>
  </div>
</section>

<!-- MANIFESTO -->
<section class="section wrap" id="manifesto">
  <div class="sec-head center reveal" style="max-width:820px">
    <h2 class="sec-title">You used to do it alone. <span class="serif">Now you have a comanager.</span></h2>
    <p class="hero-sub" style="margin-top:20px">Someone who knows your music inside out, plans your next moves, and gets them done for you. The business side isn't yours to carry alone anymore.</p>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="section wrap" id="proof">
  <div class="quote-grid reveal">
    {quotes.map((q) => (
      <div class="quote">
        <span class="mk">&ldquo;</span>
        <blockquote>{q}</blockquote>
      </div>
    ))}
  </div>
</section>

<!-- PRICING -->
<section class="section wrap" id="pricing">
  <div class="sec-head center reveal">
    <span class="eyebrow" style="justify-content:center"><span class="dot"></span>Pricing</span>
    <h2 class="sec-title">Your career, managed for <span class="serif">less than a playlist pitch.</span></h2>
    <p class="hero-sub" style="margin-top:18px">Build your Aura and run your first strategy free.</p>
  </div>
  <div class="pricing-grid reveal">
    <div class="plan">
      <p class="plan-name">Free</p>
      <div class="plan-price">$0</div>
      <p class="plan-sub">No card needed. See what a comanager would recommend before you pay.</p>
      <ul>{freePlan.map((b) => <li>{b}</li>)}</ul>
      <a class="btn btn-outline" href={SIGNIN}>Start free <span class="arrow"></span></a>
    </div>
    <div class="plan featured">
      <p class="plan-name">comanager</p>
      <div class="plan-price">$19.99<span> /mo</span></div>
      <p class="plan-sub">Or $160/year — save 33%. Less than a dollar a day.</p>
      <ul>{proPlan.map((b) => <li>{b}</li>)}</ul>
      <a class="btn btn-primary" href={SIGNIN}>Get comanager <span class="arrow"></span></a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section wrap" id="faq">
  <div class="sec-head center reveal">
    <span class="eyebrow" style="justify-content:center"><span class="dot"></span>Questions</span>
    <h2 class="sec-title">Everything you might <span class="serif">be wondering.</span></h2>
  </div>
  <div class="faq reveal">
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<!-- FINAL CTA -->
<section class="cta-sec section" id="cta">
  <div class="cta-card" style="--cta-img:url('/assets/img/cta-aura.webp')">
    <div class="photo"></div>
    <div class="veil"></div>
    <div class="inner reveal">
      <span class="eyebrow" style="justify-content:center"><span class="dot"></span>Free to start</span>
      <h2>Every artist deserves a manager.<span class="tell">Now you've got one.</span></h2>
      <div class="cta"><a class="btn btn-primary" href={SIGNIN}>Start free <span class="arrow"></span></a></div>
    </div>
  </div>
</section>

<!-- FOOTER (chat-style, componentized) -->
<SiteFooter text="A manager for every independent artist. Built by people who've managed artists." />

</div>

</Campaign>
